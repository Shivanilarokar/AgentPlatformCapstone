        <mxCell id="RTUKsWXY0yP4DzwQObPH-2" parent="1" style="whiteSpace=wrap;html=1;align=left;fillColor=light-dark(#000000,#000000);" value="&lt;div&gt;agent-runtime/&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── api/&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── invocation.py&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── compiler/&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── compiler.py&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── node_factory.py&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── edge_builder.py&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── execution/&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── executor.py&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── state.py&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── mcp/&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;├── client.py&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── connection_resolver.py&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── policies/&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── policy_engine.py&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;├── approval/&lt;/div&gt;&lt;div&gt;│&amp;nbsp; &amp;nbsp;└── approval_manager.py&lt;/div&gt;&lt;div&gt;│&lt;/div&gt;&lt;div&gt;└── runtime.py&lt;/div&gt;" vertex="1">

        <mxCell id="RTUKsWXY0yP4DzwQObPH-5" parent="1" style="text;strokeColor=none;fillColor=light-dark(#FFFFFF,#000000);html=1;whiteSpace=wrap;verticalAlign=middle;overflow=hidden;fontColor=light-dark(#000000,#33FF33);align=left;" value="&lt;ul&gt;&lt;li&gt;&lt;p class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;span style=&quot;text-align: center;&quot;&gt;It is essentially a &lt;/span&gt;&lt;strong style=&quot;text-align: center;&quot;&gt;backend service/application&lt;/strong&gt;&lt;span style=&quot;text-align: center;&quot;&gt; that you write.&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;You don&#39;t define individual agents in the runtime&#39;s source code.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">

<mxCell id="c2" value="The one deliberate cross-company path, guarded by a human. Priya's agent, runs and connections are never touched — they are not reachable from t_maven." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#4A5568;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>

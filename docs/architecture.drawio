<mxCell id="c2" value="builder/graph.py — LangGraph StateGraph, checkpointed in the company's schema. ▌▌ = interrupt(). While paused nothing runs; restart the API and the same question is still there." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#4A5568;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell>

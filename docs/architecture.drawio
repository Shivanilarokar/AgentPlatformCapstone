<mxCell id="c2" value="Two locks set on the connection, never written into a query. Handlers write select(Agent) with no WHERE." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#4A5568;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="&lt;b&gt;&lt;font color='#0E7C86'&gt;A request from Priya&lt;/font&gt;&lt;/b&gt;&lt;br&gt;cookie JWT → Claims&lt;br&gt;{user_id, tenant_key = northwind_labs, role = user}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF3F5;strokeColor=#0E7C86;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="280" height="110" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;&lt;font color='#A32A22'&gt;core/db.py::_point_at&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SET LOCAL ROLE &amp;quot;t_northwind_labs&amp;quot;   ← lock 1&lt;br&gt;SET LOCAL search_path TO &amp;quot;t_northwind_labs&amp;quot;, platform&lt;br&gt;set_config('app.user_id', &amp;lt;priya&amp;gt;)   ← lock 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEAE8;strokeColor=#A32A22;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="400" y="80" width="380" height="130" as="geometry"/></mxCell>

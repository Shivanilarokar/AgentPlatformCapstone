<mxCell id="c6" value="PostgreSQL · database forge · app connects as forge_app (NOSUPERUSER NOBYPASSRLS); pgAdmin as superuser forge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1B6E45;strokeWidth=1.5;dashed=1;fontSize=13;fontStyle=1;fontColor=#1B6E45;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1080" height="300" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;&lt;font color='#4A5568'&gt;schema platform (shared)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;tenants · users&lt;br&gt;mcp_servers · mcp_tools (Everyone)&lt;br&gt;submission_index · listings · api_tokens&lt;br&gt;&lt;br&gt;read-only for company roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#4A5568;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="70" y="340" width="300" height="200" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;&lt;font color='#1B6E45'&gt;schema t_northwind_labs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;agents · runs · submissions&lt;br&gt;mcp_servers · mcp_tools · connections&lt;br&gt;checkpoints · checkpoint_writes …&lt;br&gt;&lt;br&gt;RLS: owner_id = app.user_id&lt;br&gt;Shivani's rows | Priya's rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1E8;strokeColor=#1B6E45;strokeWidth=1.5;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="320" height="200" as="geometry"/></mxCell>
